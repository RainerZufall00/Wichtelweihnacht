# Kopieren nach .env und anpassen:  cp .env.example .env

# Deine öffentliche Adresse (die Domain der Pangolin-Resource), ohne / am Ende
PUBLIC_URL=https://wichteln.deine-domain.de

# Name des Docker-Netzes von Pangolin (prüfen mit: docker network ls)
PANGOLIN_NETWORK=pangolin

# Optional: eigenes Admin-Geheimnis (mind. 24 Zeichen). Leer lassen = wird automatisch erzeugt.
# Erzeugen mit:  openssl rand -base64 24 | tr '+/' '-_'
ADMIN_TOKEN=
